# Copy to .env and fill in values before running docker compose up.

# Required: generate with:
#   docker compose run --rm auth keygen
AUTH_MASTER_KEY=

# Base URL of this IdP — used in OIDC discovery and token issuer field.
# Change to your public hostname in production.
AUTH_ISSUER=https://localhost:8443

# PostgreSQL passwords — applied only on first init when postgres_data is empty.
AUTH_ADMIN_PASSWORD=changeme
AUTH_APP_PASSWORD=changeme

# Optional username overrides (defaults: auth_admin / auth_app).
# AUTH_ADMIN_DB_USERNAME=auth_admin
# AUTH_APP_USERNAME=auth_app

# HTTPS port exposed on the host (container always listens on 8443).
AUTH_PORT=8443

# Set to "true" to allow users to self-register at /register.
AUTH_ALLOW_REGISTRATION=false

# Outbound provisioning is configured via /portal/admin/integrations (rows in
# the app_integrations table). The vars below are used only for AWS IAM
# credentials and the optional one-time legacy-vault auto-import.

# AWS credentials for IAM-mode integrations (optional; SDK default chain works too).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Outbound mTLS — one shared client identity for every app_integrations row
# with auth_mode=mtls. The cert is hot-reloaded (mtime polled across requests),
# so tbot/cert-manager/SPIFFE rotation works without restart. Leave unset if
# every integration uses bearer-token auth.
AUTH_OUTBOUND_TLS_CERT=
AUTH_OUTBOUND_TLS_KEY=
# Optional — CA bundle for verifying downstream SCIM servers. Empty falls back
# to the system root pool.
AUTH_OUTBOUND_TLS_CA=

# Legacy vault SCIM env vars (deprecated). When AUTH_VAULT_SCIM_ENABLED=true
# and app_integrations is empty on first boot, authd auto-imports these into a
# bearer-mode integration row named "vault" and logs a deprecation warning.
# Subsequent boots ignore the env vars entirely.
AUTH_VAULT_SCIM_ENABLED=false
AUTH_VAULT_SCIM_URL=
AUTH_VAULT_SCIM_TOKEN=
# Optional, default 10s. Examples: 5s, 30s, 1m
AUTH_VAULT_SCIM_TIMEOUT=
