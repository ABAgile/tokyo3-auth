# Copy to .env and fill in values before running docker compose up.

# Required: generate with:
#   docker compose run --rm auth keygen
AUTH_MASTER_KEY=

# Base URL of this IdP — used in OIDC discovery and token issuer field.
# Change to your public hostname in production.
AUTH_ISSUER=http://localhost:8080

# PostgreSQL password for the authuser account.
POSTGRES_PASSWORD=changeme

# HTTP port exposed on the host (container always listens on 8080).
AUTH_PORT=8080

# Set to "true" to allow users to self-register at /register.
AUTH_ALLOW_REGISTRATION=false

# AWS IAM provisioning (optional)
AUTH_AWS_IAM_ENABLED=false
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
