# Rendered from teleport.yaml.tmpl by `make _gen-teleport-config`.
# @@VAR@@ markers are substituted with values from .env at render time.
version: v3
teleport:
  data_dir: /var/lib/teleport
  log:
    output: stderr
    severity: INFO
auth_service:
  enabled: true
  cluster_name: docker
  proxy_listener_mode: multiplex
  authentication:
    type: github
proxy_service:
  enabled: true
  web_listen_addr: 0.0.0.0:3080
  public_addr: @@TELEPORT_PUBLIC_ADDR@@
  # Without https_keypairs Teleport mints an ephemeral self-signed cert at
  # startup and logs "no tls keys provided, using self-signed". Point it at
  # the mkcert-issued authd-server cert which already lists teleport.localhost
  # as a SAN (see shared/certs/gen.sh) — Traefik's upstream connection still
  # uses skipverify because docker DNS resolves the service-name SNI ("teleport")
  # which isn't in the SAN list, but Teleport itself stops complaining.
  https_keypairs:
    - cert_file: /shared/certs/authd-server.crt
      key_file:  /shared/certs/authd-server.key
ssh_service:
  enabled: false
