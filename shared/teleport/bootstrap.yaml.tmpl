# Rendered from bootstrap.yaml.tmpl by `make _gen-teleport-config`.
# Loaded by the teleport-bootstrap sidecar via `tctl create --force -f`.
kind: role
version: v7
metadata:
  name: dev
spec:
  allow:
    logins: [ ubuntu, root ]
    node_labels:
      '*': '*'
---
kind: github
version: v3
metadata:
  name: tokyo3-auth
spec:
  client_id: @@TELEPORT_GITHUB_CLIENT_ID@@
  client_secret: @@TELEPORT_GITHUB_CLIENT_SECRET@@
  redirect_url: https://@@TELEPORT_PUBLIC_ADDR@@/v1/webapi/github/callback
  # endpoint_url / api_endpoint_url are Teleport Enterprise-only fields.
  # On CE, tctl rejects the connector when they're set, and even if accepted
  # they'd be ignored at runtime — the connector hard-codes github.com /
  # api.github.com. The docker-compose.teleport.yml extra_hosts entries route
  # those names to host.docker.internal, so we point auth at the standard
  # github URLs and let the host DNS hijack do the redirection.
  #endpoint_url: @@AUTH_ISSUER@@
  #api_endpoint_url: @@AUTH_ISSUER@@/api/v3
  display: tokyo3-auth
  # `dev` role grants `logins: [ubuntu, root]`; the connector mapping just
  # routes a github team to that role.
  # `organization` must match what /api/v3/user/orgs returns, which auth
  # derives from the AUTH_ISSUER hostname (syntheticOrgLogin in github.go).
  # `members` is a synthetic team auth's /user/teams always includes for any
  # authenticated user — see handleGitHubUserTeams in internal/api/github.go.
  # Swap to a real SCIMGroup display-name (lower-cased, hyphenated) once you
  # have one in auth and want per-group role mapping.
  teams_to_roles:
    - organization: @@AUTH_HOST@@
      team: members
      roles: [ dev, editor ]
