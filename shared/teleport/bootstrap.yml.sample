# make _sync-shared copies this to bootstrap.yml if it does not exist.
# After creating the Teleport OAuth client in auth, replace CHANGE_ME_* in
# bootstrap.yml with the client credentials from auth.
kind: role
version: v7
metadata:
  name: dev
spec:
  allow:
    logins: [ ubuntu, root ]
    node_labels:
      '*': '*'
---
kind: github
version: v3
metadata:
  name: tokyo3-auth
spec:
  client_id: CHANGE_ME_CLIENT_ID
  client_secret: CHANGE_ME_CLIENT_SECRET
  redirect_url: https://teleport.localhost/v1/webapi/github/callback
  # endpoint_url / api_endpoint_url are Teleport Enterprise-only fields.
  # On CE, tctl rejects the connector when they're set, and even if accepted
  # they'd be ignored at runtime — the connector hard-codes github.com /
  # api.github.com. The compose extra_hosts entries route those names to
  # Traefik, which redirects them to auth.localhost.
  #endpoint_url: https://auth.localhost
  #api_endpoint_url: https://auth.localhost/api/v3
  display: tokyo3-auth
  teams_to_roles:
    - organization: auth.localhost
      team: members
      roles: [ dev, editor ]
